{
  "manifest_version": 3,
  "name": "FoxWatch Email Scanner",
  "version": "0.1.0",
  "description": "Helps detect potentially suspicious or phishing emails in Gmail.",
  "action": {
    "default_popup": "dashboard.html"
  },
  "options_ui": {
    "page": "setup.html",
    "open_in_tab": true
  },
  "permissions": ["activeTab", "storage", "nativeMessaging"],
  "host_permissions": [
    "http://127.0.0.1:8000/*"
  ],
  "background": {
    "service_worker": "sw.js"
  },
  "content_scripts": [
    {
      "matches": [ "https://mail.google.com/*" ],
      "js": [ "trustedcontact.js", "content.js" ],
      "css": [ "styles.css" ]
    }
  ]
}